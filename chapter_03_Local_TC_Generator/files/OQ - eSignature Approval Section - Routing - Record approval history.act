# #################################################################################################
# TC_2.2: When using global Route action.
# Expected Result(s): 
#                  - Electronic signature section does not contain any record. 
# #################################################################################################

CREATE_NEW_DOCUMENT "VALIDATION_DOCUMENT" "VALIDATION_TEST_DRAFT"
SetFormElement "VALIDATION_TITLE" "New document created to test the contents of Approvals Section"
CLICK_ACTION "Save"
CHECK_ERRORS
StoreDocumentKey	"Route-Action2"
OPEN_DOCUMENT_TAB "ACCESS_CONTROL_TAB"
CheckFormElementNotPresent   "ETQ$APPROVALS_ETQ$APPROVALS_DIS_USER_0_HIDDEN"
CheckFormElementNotPresent   "ETQ$APPROVALS_ETQ$APPROVALS_DIS_PHASE_0_HIDDEN" 
CheckFormElementNotPresent  "ETQ$APPROVALS_ETQ$APPROVALS_DIS_DATE_0_HIDDEN"
CHECK_NUMBER_OF_APPROVAL_SECTION_RECORDS "0"

CLICK_ACTION  "Cancel"
CHECK_ERRORS

# Route the document to the next phase using route action.

SelectDocumentByKey "Route-Action2"
CLICK_ACTION "Route"
CHECK_ERRORS
ADD_USER_TO_NAMES_FIELD "GLOBAL_ROUTE_DIALOG_SELECTED_DOCUMENTS_INFO_GLOBAL_ROUTE_DIALOG_ASSIGN_TO_0" "D-User8"
CLICK_ACTION "global_route_dialog_ok"
SET_PASSWORD  "etq-user8"
Submit
CHECK_ERRORS

# Checking the contents of approvals section.
OpenDocumentByKey "Route-Action2"
OPEN_DOCUMENT_TAB	"ACCESS_CONTROL_TAB"
CheckFormElementNotPresent  "ETQ$APPROVALS_ETQ$APPROVALS_DIS_USER_0_HIDDEN"
CheckFormElementNotPresent  "ETQ$APPROVALS_ETQ$APPROVALS_DIS_PHASE_0_HIDDEN"
CHECK_NUMBER_OF_APPROVAL_SECTION_RECORDS "0"
CLICK_ACTION  "Cancel"
