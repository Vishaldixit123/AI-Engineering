OPEN_DOCUMENT_TAB "ACCESS_CONTROL_TAB"
CheckFormElementNotPresent  "ETQ$APPROVALS_ETQ$APPROVALS_DIS_USER_0_HIDDEN"
CheckFormElementNotPresent  "ETQ$APPROVALS_ETQ$APPROVALS_DIS_PHASE_0_HIDDEN"
CheckFormElementNotPresent "ETQ$APPROVALS_ETQ$APPROVALS_DIS_DATE_0_HIDDEN" 
CHECK_NUMBER_OF_APPROVAL_SECTION_RECORDS "0"
ROUTE_TO_PHASE_WITH_AUTHENTICATION "PhaseName_Validation_Review"	"EtQ-User7" "etq-user7"

# Check Electronic Signature subform fields data 
OpenDocumentByKey "Sending-Forward2"
OPEN_DOCUMENT_TAB "ACCESS_CONTROL_TAB"
CheckFormElementNotPresent   "ETQ$APPROVALS_ETQ$APPROVALS_DIS_USER_0_HIDDEN"
CheckFormElementNotPresent   "ETQ$APPROVALS_ETQ$APPROVALS_DIS_PHASE_0_HIDDEN"
CheckFormElementNotPresent  "ETQ$APPROVALS_ETQ$APPROVALS_DIS_DATE_0_HIDDEN"
CHECK_NUMBER_OF_APPROVAL_SECTION_RECORDS "0"
CLICK_ACTION  "Cancel"
